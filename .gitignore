# download cache + build output
/vendor/
/dist/

# node
node_modules/
app/renderer/tailwind.css

# python / build runtime (runtimes live under dist/runtime; runtime/ is the
# committed uv workspace, NOT ignored)
__pycache__/
*.pyc

# editor / os
.DS_Store
*.swp
/app/.stage/
/app/.stage.lock
/.run-data/
/app/.run/
/.claude/
/models/
/result
/launcher/vendor/

# Rust build artifacts (every crate's target/ — launcher, spa, spinner, xtask,
# mock-server, and all crates/*)
/launcher/spa-src/target/
/launcher/spa-src/.cargo/
/launcher/target/
/spinner/target/
/xtask/target/
/mock-server/target/
/crates/*/target/
/build.ninja
/.ninja_log
/.ninja_lock
/launcher/spa/
# store-import build layer: per-import records (dist/ is ignored) + indirect GC
# roots are machine-specific. nix/stores.nix is committed (it just reads the records).
/.nix-gcroots/
/launcher/spa-src/assets/tailwind.css
