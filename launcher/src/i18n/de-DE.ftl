# plan.ai launcher — user-facing notification strings (Deutsch).
already-running = plan.ai läuft bereits.
safe-to-unplug = Daten geschrieben - Laufwerk kann jetzt entfernt werden.
starting-preparing = plan.ai startet — Laufzeit wird vorbereitet…
provisioning = Erster Start — plan.ai wird auf das Laufwerk geladen…
provisioning-progress = Erster Start — plan.ai wird auf das Laufwerk geladen… ({$done}/{$total})
update-applied = Update angewendet — plan.ai wird neu gestartet.
applying-update = plan.ai wird aktualisiert…
